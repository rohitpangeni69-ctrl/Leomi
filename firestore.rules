rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }
    
    // 3. Primitives
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'rohitpangeni69@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }
    
    // Validation Helpers
    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'description', 'price', 'category', 'sizes', 'colors', 'images', 'inStock', 'createdAt']) &&
             data.keys().size() == 9 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.description is string && data.description.size() <= 2000 &&
             data.price is number && data.price >= 0 &&
             data.category in ['Women', 'Men', 'Accessories'] &&
             data.sizes is list && data.sizes.size() <= 20 &&
             data.colors is list && data.colors.size() <= 20 &&
             data.images is list && data.images.size() <= 10 &&
             data.inStock is bool &&
             data.createdAt is number;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['userId', 'items', 'totalAmount', 'status', 'shippingAddress', 'paymentMethod', 'paymentStatus', 'createdAt']) &&
             data.keys().size() == 8 &&
             data.userId == request.auth.uid &&
             data.items is list && data.items.size() > 0 && data.items.size() <= 50 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.status in ['Pending', 'Processing', 'Shipped', 'Delivered', 'Cancelled'] &&
             data.shippingAddress is map && data.shippingAddress.keys().hasAll(['fullName', 'phone', 'city', 'area', 'street']) &&
             data.shippingAddress.fullName is string && data.shippingAddress.fullName.size() <= 100 &&
             data.shippingAddress.phone is string && data.shippingAddress.phone.size() <= 20 &&
             data.shippingAddress.city is string && data.shippingAddress.city.size() <= 100 &&
             data.shippingAddress.area is string && data.shippingAddress.area.size() <= 100 &&
             data.shippingAddress.street is string && data.shippingAddress.street.size() <= 200 &&
             data.paymentMethod in ['eSewa', 'Khalti', 'COD'] &&
             data.paymentStatus in ['Pending', 'Completed', 'Failed'] &&
             data.createdAt is number;
    }
    
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'displayName', 'role', 'createdAt']) &&
             data.keys().size() == 4 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 100 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.role in ['user', 'admin'] &&
             data.createdAt is number;
    }

    match /products/{productId} {
      allow list, get: if true;
      allow create: if isAdmin() && isValidId(productId) && isValidProduct(incoming());
      allow update: if (isAdmin() && isValidId(productId) && isValidProduct(incoming())) &&
        (incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'price', 'category', 'sizes', 'colors', 'images', 'inStock']));
      allow delete: if isAdmin() && isValidId(productId);
    }
    
    match /orders/{orderId} {
      allow get, list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(orderId) && isValidOrder(incoming());
      allow update: if (isAdmin() && isValidId(orderId) && isValidOrder(incoming())) &&
        (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'paymentStatus']));
      allow delete: if isAdmin() && isValidId(orderId);
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && (isAdmin() || incoming().role == 'user');
      
      allow update: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidUser(incoming()) &&
        (isAdmin() || 
         (incoming().diff(existing()).affectedKeys().hasOnly(['displayName']) && 
          incoming().role == existing().role && incoming().email == existing().email && incoming().createdAt == existing().createdAt));
      
      allow delete: if isAdmin() && isValidId(userId);
    }
  }
}
