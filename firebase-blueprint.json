{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A fashion product in the catalog",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string", "enum": ["Women", "Men", "Accessories"] },
        "sizes": { "type": "array" },
        "colors": { "type": "array" },
        "images": { "type": "array" },
        "inStock": { "type": "boolean" },
        "createdAt": { "type": "number" }
      },
      "required": ["name", "description", "price", "category", "sizes", "colors", "images", "inStock", "createdAt"]
    },
    "Order": {
      "title": "Order",
      "description": "A user's order",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["Pending", "Processing", "Shipped", "Delivered", "Cancelled"] },
        "shippingAddress": { "type": "object" },
        "paymentMethod": { "type": "string", "enum": ["eSewa", "Khalti", "COD"] },
        "paymentStatus": { "type": "string", "enum": ["Pending", "Completed", "Failed"] },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "items", "totalAmount", "status", "shippingAddress", "paymentMethod", "paymentStatus", "createdAt"]
    },
    "User": {
      "title": "User Profile",
      "description": "User profile with roles",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "number" }
      },
      "required": ["email", "displayName", "role", "createdAt"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Products catalog"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "User orders"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    }
  }
}
